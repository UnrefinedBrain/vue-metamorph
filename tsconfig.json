{
  "compilerOptions": {
    "esModuleInterop": true,
    "isolatedModules": true,
    "lib": [
      "ESNext",
      // the docs ship an AST explorer that runs the parsers in the browser
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "declarationMap": true,
    "declarationDir": "dist",
    "emitDeclarationOnly": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "useDefineForClassFields": true,
    "types": ["node"]
  },
  "include": ["src", "docs"],
  "exclude": ["src/vendor/ast-types", "src/vendor/recast"],
  "references": [
    { "path": "./src/vendor/ast-types" },
    { "path": "./src/vendor/recast" }
  ]
}
